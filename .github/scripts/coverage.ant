#!/usr/bin/env ant

//! Coverage runs the tests with a coverage profile and fails when statement coverage is below the
//! minimum.
//!
//!     ant run .github/scripts/coverage.ant
//!
//! It writes coverage.out and coverage.html in the repository root, without the excluded packages.

let expected = 90.0

// A profile line whose file path contains one of these is left out.
let exclude = [
  "expr/test/",         // We do not need to test the test package.
  "checker/mock/",      // Mocks only used for testing.
  "vm/func_types",      // Generated files.
  "vm/runtime/helpers", // Generated files.
  "internal/difflib/",  // Test dependency. This is vendored dependency, and ideally we also have good tests for it.
  "internal/spew/",     // Test dependency.
  "internal/testify/",  // Test dependency.
  "patcher/value/",     // Contains a lot of repeating code. Ideally we should have a test for it.
  "expr/pro/",          // Expr Pro is not a part of the main codebase.
]

let root = Path.join([Path.dir(Os.program()), "..", ".."])
let profile = Path.join([root, "coverage.out"])

func goCmd(args: Array[string]): Cmd {
  Cmd.new("go", args, dir: root)
}

let test = goCmd(["test", "-coverprofile=coverage.out", "-coverpkg=github.com/expr-lang/expr/...", "./..."])
let status = try test.run()
if status != 0 { Os.exit(status) }

let kept = String.lines(try File.read(profile)).filter(func(line: string): bool {
  !exclude.some({ String.contains(line, x) })
})
try File.write(profile, kept | String.join("\n"))
try goCmd(["tool", "cover", "-html=coverage.out", "-o", "coverage.html"]).read()

let report = try goCmd(["tool", "cover", "-func=coverage.out"]).read()
println(report)
let found = Regex.find(/total:\s+\(statements\)\s+(\d+\.\d+)%/, report)?.groups[1] ??
  return Result.fail("no total in the coverage report")
let total = String.toFloat(found) ?? return Result.fail("not a number: ${found}")
if total < expected {
  eprintln("Coverage is too low: ${total}% < ${expected}% (expected)")
  Os.exit(1)
}
println("Coverage is good: ${total}% >= ${expected}% (expected)")
